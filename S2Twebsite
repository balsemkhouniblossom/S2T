		alertDiv.dir='rtl';
		alertDiv.style.textAlign = 'right';
		updateDateText = 'تاريخ آخر تحديث: ';
	}

	// Ajouter le message secondaire s'il est défini et que le type est 'success'
	if (secondaryMessage && type != 'warning') {
		var secondaryMessageNode = document.createElement('p');
		secondaryMessageNode.textContent = updateDateText + secondaryMessage;
