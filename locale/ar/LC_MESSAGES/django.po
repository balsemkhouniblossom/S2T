# Home hero and sections
#: .\templates\home.html:10
msgid "Plateforme de formation moderne, fiable et professionnelle"
msgstr "منصة تدريب حديثة وموثوقة واحترافية"

#: .\templates\home.html:11
msgid ""
"Découvrez des contenus de qualité, des formateurs experts et une expérience "
"fluide. Commencez votre parcours avec une interface claire, des actions "
"nettes et une navigation simple."
msgstr ""
"اكتشف محتوى عالي الجودة ومدربين خبراء وتجربة سلسة. ابدأ رحلتك بواجهة واضحة "
"وإجراءات دقيقة وتنقل بسيط."

#: .\templates\home.html:13
msgid "Explorer les Formations"
msgstr "استكشف الدورات"

#: .\templates\home.html:14
msgid "Commencer Gratuitement"
msgstr "ابدأ مجانًا"

#: .\templates\home.html:23
msgid "Pourquoi choisir notre plateforme ?"
msgstr "لماذا تختار منصتنا؟"

#: .\templates\home.html:24
msgid ""
"Une expérience d'apprentissage moderne et personnalisée pour tous les niveaux"
msgstr "تجربة تعلم حديثة ومخصصة لجميع المستويات"

#: .\templates\home.html:28
msgid "Formations de Qualité"
msgstr "دورات عالية الجودة"

#: .\templates\home.html:29
msgid ""
"Contenus créés par des experts, actualisés régulièrement pour rester "
"pertinents."
msgstr "محتوى من إنشاء خبراء ويتم تحديثه بانتظام ليظل ذا صلة."

#: .\templates\home.html:33
msgid "Communauté Active"
msgstr "مجتمع نشط"

#: .\templates\home.html:34
msgid "Échanges, support et progression en groupe pour rester motivé."
msgstr "تفاعل ودعم وتقدم جماعي للحفاظ على التحفيز."

#: .\templates\home.html:38
msgid "Certificats Reconnus"
msgstr "شهادات معترف بها"

#: .\templates\home.html:39
msgid "Valorisez vos compétences et votre parcours professionnel."
msgstr "عزز مهاراتك ومسارك المهني."

#: .\templates\home.html:43
msgid "Apprentissage Flexible"
msgstr "تعلم مرن"

#: .\templates\home.html:44
msgid "À votre rythme, sur tous vos appareils, sans contrainte."
msgstr "وفق وتيرتك وعلى جميع أجهزتك دون قيود."

#: .\templates\home.html:48
msgid "Formateurs Experts"
msgstr "مدربون خبراء"

#: .\templates\home.html:49
msgid "Des professionnels qualifiés, pédagogues et à l’écoute."
msgstr "محترفون مؤهلون وذوو نهج تربوي ومصغون."

#: .\templates\home.html:53
msgid "Multi-Plateforme"
msgstr "متعدد المنصات"

#: .\templates\home.html:54
msgid "Accès depuis ordinateur, tablette et smartphone."
msgstr "وصول من الكمبيوتر واللوحي والهاتف الذكي."

#: .\templates\home.html:86
msgid "Prêt à commencer votre apprentissage ?"
msgstr "هل أنت مستعد لبدء التعلم؟"

#: .\templates\home.html:87
msgid ""
"Rejoignez des milliers d'apprenants qui ont déjà transformé leur carrière."
msgstr "انضم إلى الآلاف من المتعلمين الذين غيروا مسارهم المهني بالفعل."

#: .\templates\home.html:89
msgid "Commencer Maintenant"
